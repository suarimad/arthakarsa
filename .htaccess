<Files ".env">
    Order allow,deny
    Deny from all
</Files>

RewriteEngine On

# [BARU] Rule untuk halaman Edit Employee menggunakan UUID
RewriteRule ^employee_edit/user/([a-zA-Z0-9-]+)/?$ employee_edit.php?uuid=$1 [L,QSA]
RewriteRule ^leave_add/([a-zA-Z0-9_-]+)/?$ leave_add.php?type=$1 [L,QSA]
RewriteRule ^payslips_detail/([0-9]+)/([0-9]+)$ payslips_detail.php?month=$1&year=$2 [L,QSA]

# 1. EXTERNAL REDIRECT: Paksa hapus .php jika diketik langsung di browser
# (Menangkap URL sebelum ekstensi .php dan membelokkannya)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. INTERNAL REWRITE: Cari file .php di belakang layar jika URL tanpa ekstensi dipanggil
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]